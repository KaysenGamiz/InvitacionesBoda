<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin · Invitaciones</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%235c1620'/%3E%3Ctext x='32' y='43' font-family='Georgia, serif' font-size='26' fill='%23efe6d8' text-anchor='middle'%3ERK%3C/text%3E%3C/svg%3E" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin">
  <div class="admin-wrap">
    <div class="card login-box">
      <h1 class="center">Acceso admin</h1>
      <% if (error) { %>
        <div class="error-msg"><%= error %></div>
      <% } %>
      <form method="POST" action="/admin/login">
        <label class="field-label" for="username">Usuario</label>
        <input type="text" id="username" name="username" required />
        <label class="field-label" for="password">Contraseña</label>
        <input type="password" id="password" name="password" required />
        <div class="center" style="margin-top: 20px;">
          <button class="btn btn-primary" type="submit">Entrar</button>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
