PORT=3000

# MongoDB Atlas connection string (crea un cluster gratis en mongodb.com/atlas)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.mongodb.net/boda?retryWrites=true&w=majority

# Dominio publico donde vivira la app (para generar los links de invitacion)
BASE_URL=http://localhost:3000

# Clave para firmar la sesion del admin (pon cualquier texto largo y aleatorio)
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Credenciales del panel de administracion
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena
